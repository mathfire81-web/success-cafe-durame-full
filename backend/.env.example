# Copy to .env and fill in.

PORT=3000
NODE_ENV=development

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/success_cafe

# Any long random string. Signs the admin login session.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Used ONLY by `npm run seed` to create/update the first admin login.
# Leave ADMIN_PASSWORD blank to skip creating an admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Used ONLY by the admin dashboard's menu-photo upload button (Menu
# Page -> item editor -> Upload Photo). Optional - everything else
# works fine without these, you just won't be able to upload photos
# from your device (pasting an image URL directly still works either
# way). Get these from Supabase: Project Settings -> API.
#   SUPABASE_URL is the "Project URL" (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key -
#     NEVER the anon/public key, and never expose this to the
#     frontend - it bypasses Row Level Security.
# You also need a PUBLIC Storage bucket named "menu-images" (or set
# SUPABASE_MENU_BUCKET to whatever you named it) in that same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MENU_BUCKET=menu-images

# Optional - sends a Telegram message to you for every new order and
# pre-order. Leave blank to skip notifications entirely.
#   TELEGRAM_BOT_TOKEN: from @BotFather after "/newbot"
#   TELEGRAM_CHAT_ID:   your numeric chat id, from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
