# Copy to .env and fill in.

PORT=3000
NODE_ENV=development

# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/success_cafe

# Any long random string. Signs the admin login session.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Used ONLY by `npm run seed` to create/update the first admin login.
# Leave ADMIN_PASSWORD blank to skip creating an admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
